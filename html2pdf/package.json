{
  "name": "html2pdf-cli",
  "version": "1.0.0",
  "description": "Конвертер HTML -> PDF для Windows на базе headless Chromium (Puppeteer). Идеальное сохранение CSS (flex/grid/media), картинок, шрифтов и JS-рендеринга.",
  "license": "MIT",
  "bin": {
    "html2pdf": "dist/index.js"
  },
  "main": "dist/index.js",
  "scripts": {
    "clean": "rimraf dist html2pdf.exe",
    "build:ts": "tsc -p tsconfig.json",
    "build:exe": "pkg . --targets node18-win-x64 --output html2pdf.exe --compress GZip",
    "build": "npm run clean && npm run build:ts && npm run build:exe",
    "start": "node dist/index.js",
    "dev": "ts-node src/index.ts"
  },
  "pkg": {
    "assets": [
      "node_modules/@puppeteer/browsers/**/*"
    ],
    "scripts": [
      "dist/**/*.js"
    ]
  },
  "dependencies": {
    "@pdf-lib/fontkit": "^1.1.1",
    "@puppeteer/browsers": "^2.4.0",
    "cli-progress": "^3.12.0",
    "p-limit": "^3.1.0",
    "pdf-lib": "^1.17.1",
    "picocolors": "^1.1.0",
    "puppeteer-core": "^23.6.0",
    "yargs": "^17.7.2"
  },
  "devDependencies": {
    "@types/cli-progress": "^3.11.6",
    "@types/node": "^18.19.0",
    "@types/yargs": "^17.0.33",
    "@yao-pkg/pkg": "^5.16.1",
    "rimraf": "^5.0.10",
    "ts-node": "^10.9.2",
    "typescript": "^5.6.3"
  }
}
