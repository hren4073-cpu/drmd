--- a/src/htscoremain.c
+++ b/src/htscoremain.c
@@ -35,6 +35,7 @@
 #define HTS_INTERNAL_BYTECODE
 
 #include "htscoremain.h"
+#include "httrack_pdf.h"      /* PDF export / article-clean module */
 
 #include "htsglobal.h"
 #include "htscore.h"
@@ -197,6 +198,47 @@
   /* Init root dir */
   hts_rootdir(argv[0]);
 
+  /* ---- PDF export module: collect native --pdf-* options ---- */
+  {
+    char pdfcfg[2048];
+    int have_pdf = 0, r, w = 1;
+    pdfcfg[0] = '\0';
+    for(r = 1; r < argc; r++) {
+      const char *a = argv[r];
+      if (strcmp(a, "--pdf-export") == 0) {
+        strcat(pdfcfg, "export,"); have_pdf = 1;
+      } else if (strcmp(a, "--pdf-merge") == 0) {
+        strcat(pdfcfg, "merge,"); have_pdf = 1;
+      } else if (strcmp(a, "--pdf-no-images") == 0) {
+        strcat(pdfcfg, "noimg,"); have_pdf = 1;
+      } else if (strcmp(a, "--pdf-keep-comments") == 0) {
+        strcat(pdfcfg, "keepcomments,"); have_pdf = 1;
+      } else if (strcmp(a, "--pdf-drop-comments") == 0) {
+        strcat(pdfcfg, "nocomments,"); have_pdf = 1;
+      } else if (strcmp(a, "--pdf-page-size") == 0 && r + 1 < argc) {
+        strcat(pdfcfg, "pagesize="); strcat(pdfcfg, argv[++r]);
+        strcat(pdfcfg, ","); have_pdf = 1;
+      } else if (strcmp(a, "--pdf-concurrency") == 0 && r + 1 < argc) {
+        strcat(pdfcfg, "concurrency="); strcat(pdfcfg, argv[++r]);
+        strcat(pdfcfg, ","); have_pdf = 1;
+      } else if (strcmp(a, "--pdf-clean") == 0 && r + 1 < argc) {
+        strcat(pdfcfg, "clean="); strcat(pdfcfg, argv[++r]);
+        strcat(pdfcfg, ","); have_pdf = 1;
+      } else if (strcmp(a, "--pdf-timeout") == 0 && r + 1 < argc) {
+        strcat(pdfcfg, "timeout="); strcat(pdfcfg, argv[++r]);
+        strcat(pdfcfg, ","); have_pdf = 1;
+      } else if (strncmp(a, "--pdf-chrome=", 13) == 0) {
+        strcat(pdfcfg, "chrome="); strcat(pdfcfg, a + 13);
+        strcat(pdfcfg, ","); have_pdf = 1;
+      } else {
+        argv[w++] = argv[r];   /* keep all non --pdf-* arguments */
+      }
+    }
+    argc = w;
+    if (have_pdf)
+      httrack_pdf_init(opt, pdfcfg);
+  }
+
 #ifdef _WIN32
 #else
   /* Terminal is a tty, may ask questions and display funny information */
